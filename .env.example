# Base URL of the product API (the existing management software).
# Leave empty until the real endpoint is known; the catalog then shows an honest "not connected" state.
VITE_API_BASE_URL=/api
# Path of the product list endpoint, relative to the base URL (e.g. /products). Not known yet.
VITE_API_PRODUCTS_PATH=catalog

# Official WhatsApp number in international format, digits only (e.g. 549223XXXXXXX).
# Not verified yet. While empty, purchase inquiries fall back to an Instagram DM.
VITE_WHATSAPP_NUMBER=

# Development only: load demo products from src/features/products/fixtures.ts.
# Ignored in production builds. Pages show a "datos de demostración" banner while active.
VITE_USE_FIXTURES=false

# Never put a secret API key in a VITE_* variable: every VITE_* value ships to the browser.
# If the API needs a private key, it must be called through a server-side proxy (see docs/api-integration.md).

# Server-only (no VITE_ prefix, never reaches the browser): Stackr API key with stock:read, used by api/catalog.ts.
# Set it in .env.local for dev and in the host's environment variables for production.
STACKR_API_KEY=
